// Model-lineage compat for "meta"; regenerated from the frozen census using class taxonomy selectors.

class "meta" {
	// Exact ids on purpose: only an exact selector upgrades hosts whose
	// discovery misreports a Muse Spark revision as non-reasoning.
	models "muse-spark-1.2" "muse-spark-1.2-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
	// 1.3 adds a "max" tier above "xhigh".
	models "muse-spark-1.3" "muse-spark-1.3-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
		thinking-mode "effort"
	}
	// The `meta/`-prefixed ids are the same models served through reseller
	// namespaces (kilo, nanogpt, openrouter, vercel-ai-gateway, zenmux):
	// exact match runs against the provider-relative id, so the bare ids
	// alone miss them. No `thinking-mode` here — the mode is an API dialect
	// (budget on anthropic-messages, effort elsewhere) and the API-derived
	// default already reproduces each row.
	models "meta/muse-spark-1.3" "meta/muse-spark-1.3-contributor" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
	}
	on "kilo" "nvidia" {
		family "llama" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
}
